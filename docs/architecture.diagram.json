  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "E-mail and password sign-in, server-side session in an HttpOnly cookie",
        "Role check on every route: viewer, clerk, approver, admin",
        "Row-level security binds every query to the caller's organisation",
        "Audit log of sign-ins, decisions and administrator changes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Document pipeline",
      "items": [
        "Uploads are checked by content and stored by SHA-256",
        "Digital PDFs use the text layer; scans use Tesseract OCR",
        "Extraction stores a value only if it is found on the page",
        "Matching and checks are deterministic and use no model"
      ]
    },
    {
      "dot": "violet",
      "title": "Exceptions and approvals",
      "items": [
        "A held invoice opens one exception for the agent",
        "The agent reads through typed tools; it stores a recommendation and a draft only",
        "A person accepts or decides; approval tiers and separation of duties apply",
        "Nothing is paid by this system"
      ]
    }
  ]
