# ProcureMind configuration. Copy to .env; every value has a working default for local use.

# --- Secrets (change for anything that is not a local demo) ---
SECRET_KEY=                      # encrypts provider keys saved from the UI. Set a long random value;
                                 # the built-in default is public and only suitable for a local demo
POSTGRES_PASSWORD=postgres
PROCUREMIND_OWNER_PASSWORD=procuremind_owner
PROCUREMIND_APP_PASSWORD=procuremind_app

# --- Network ---
WEB_BIND=127.0.0.1               # address the UI port is published on. 127.0.0.1: this machine only (default).
                                 # 0.0.0.0: every network interface, over plain HTTP; put HTTPS in front first.

# --- Accounts ---
SEED_DEMO=true                   # create the two demo organisations, eight demo users and the demo data
DEMO_SCALE=0.25            # share of the full demo data set (vendors, orders, documents) generated at first start
COOKIE_SECURE=false              # true behind HTTPS
ALLOW_SIGNUP=true                # false to stop new organisations signing up
CORS_ORIGINS=http://localhost:3300

# --- LLM (see docs/PROVIDERS.md for every provider) ---
LLM_PROVIDER=stub                # openai_compat | anthropic | ollama | stub
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_PRICE_INPUT_PER_MTOK=3.0     # USD per million tokens, used for cost estimates and budgets
LLM_PRICE_OUTPUT_PER_MTOK=15.0
ALLOW_PRIVATE_LLM_URLS=true      # false on a shared deployment (blocks base URLs on private networks)

# --- Agent budgets ---
RUN_MAX_STEPS=25
RUN_MAX_TOKENS=200000
RUN_MAX_SECONDS=300
RUN_MAX_COST_USD=1.00
ORG_DAILY_COST_USD=20.00
GLOBAL_DAILY_COST_USD=200.00     # all organisations together
ORG_MAX_CONCURRENT_RUNS=5
ORG_MAX_QUEUED_RUNS=15           # runs waiting beyond the concurrent limit before new ones get 429

# --- Exception Agent ---
AUTO_INVESTIGATE=false           # true: the Exception Agent starts on every new exception (set a real model first)

# --- Monitoring ---
METRICS_TOKEN=                   # when set, /metrics requires "Authorization: Bearer <token>"

# --- Scale ---
WORKER_CONCURRENCY=4
OTEL_EXPORTER_OTLP_ENDPOINT=     # set to export traces, e.g. AgentOps at http://host.docker.internal:3200, or a collector on :4318
OTEL_EXPORTER_OTLP_HEADERS=      # e.g. Authorization=Bearer%20ak_... (an AgentOps ingestion key); keep it out of the repository
